# 이 파일을 .env.local 로 복사해서 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# ── 이메일: SMTP 직접 발송 (권장) ────────────────────────────────────────
# Gmail이면 2단계 인증을 켜고 앱 비밀번호를 발급해서 SMTP_PASS 에 넣으세요.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quelle.bk@gmail.com
SMTP_PASS=
# SMTP_FROM=  # 생략하면 SMTP_USER

# ── 이메일: ntfy 경유 (대안) ─────────────────────────────────────────────
# ntfy.sh 계정을 만들고 발급받은 토큰(tk_...)을 넣으면 ntfy가 메일도 보냅니다.
# NTFY_TOKEN=tk_xxxxxxxx

# ── 알림 제목에 쓸 이름 ──────────────────────────────────────────────────
# ALERT_LABEL=예약
